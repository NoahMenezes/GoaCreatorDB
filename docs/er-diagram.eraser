// ============================================================================
// GoaConnect Database Schema - Eraser Diagram-as-Code
// File: docs/er-diagram.eraser
// Description: Complete Entity-Relationship Diagram representing the 11 ERD
//              business tables and 3 supporting system tables.
// ============================================================================

// ----------------------------------------------------------------------------
// Core ERD Entities
// ----------------------------------------------------------------------------

users [icon: user, color: blue] {
  user_id int pk
  email citext unique
  password_hash text
  role text
  is_verified boolean
  created_at timestamptz
  updated_at timestamptz
}

locations [icon: map-pin, color: green] {
  location_id int pk
  area_name text
  taluka text
  district text
}

categories [icon: tag, color: purple] {
  category_id int pk
  category_name text unique
}

businesses [icon: store, color: orange] {
  business_id int pk
  user_id int fk unique
  location_id int fk
  business_name text
  industry text
  description text
  contact_phone text
  instagram_handle text
}

creators [icon: camera, color: cyan] {
  creator_id int pk
  user_id int fk unique
  location_id int fk
  full_name text
  bio text
  accepts_barter boolean
  min_paid_rate int
  created_at timestamptz
}

creator_categories [icon: layers, color: purple] {
  creator_id int pk fk
  category_id int pk fk
  is_primary boolean
}

social_accounts [icon: share-2, color: pink] {
  account_id int pk
  creator_id int fk
  platform text
  handle text
  profile_url text
}

creator_metrics [icon: trending-up, color: green] {
  metric_id int pk
  account_id int fk
  follower_count int
  avg_likes numeric
  avg_views numeric
  avg_comments numeric
  engagement_rate numeric
  audience_goa_pct numeric
  data_source text
  verified_by int fk
  recorded_at timestamptz
}

collaboration_requests [icon: handshake, color: amber] {
  request_id int pk
  business_id int fk
  creator_id int fk
  collab_type text
  offered_amount int
  offer_details text
  deliverables text
  message text
  status text
  requested_at timestamptz
  responded_at timestamptz
  deadline date
}

reviews [icon: star, color: yellow] {
  review_id int pk
  request_id int fk
  reviewer_id int fk
  reviewee_id int fk
  rating int
  comment text
  created_at timestamptz
}

shortlists [icon: bookmark, color: red] {
  business_id int pk fk
  creator_id int pk fk
  note text
  saved_at timestamptz
}

// ----------------------------------------------------------------------------
// Supporting System Infrastructure Entities
// ----------------------------------------------------------------------------

sessions [icon: key, color: slate] {
  session_id int pk
  token text unique
  user_id int fk
  created_at timestamptz
  expires_at timestamptz
}

password_reset_tokens [icon: lock, color: slate] {
  token_id int pk
  user_id int fk
  token_hash text unique
  expires_at timestamptz
  used_at timestamptz
}

audit_log [icon: file-text, color: slate] {
  log_id int pk
  table_name text
  record_id int
  action text
  old_data jsonb
  new_data jsonb
  changed_by int fk
  changed_at timestamptz
}

// ----------------------------------------------------------------------------
// Entity Relationships
// ----------------------------------------------------------------------------

// 1-to-1 Profile Specializations
users.user_id - businesses.user_id
users.user_id - creators.user_id

// Geographic References
locations.location_id < businesses.location_id
locations.location_id < creators.location_id

// Content Categorization (Many-to-Many)
creators.creator_id < creator_categories.creator_id
categories.category_id < creator_categories.category_id

// Social Presence & Audience Metric Snapshots
creators.creator_id < social_accounts.creator_id
social_accounts.account_id < creator_metrics.account_id
users.user_id < creator_metrics.verified_by

// Collaboration Campaign Lifecycle
businesses.business_id < collaboration_requests.business_id
creators.creator_id < collaboration_requests.creator_id

// Bilateral Reviews
collaboration_requests.request_id < reviews.request_id
users.user_id < reviews.reviewer_id
users.user_id < reviews.reviewee_id

// Business Shortlists (Many-to-Many)
businesses.business_id < shortlists.business_id
creators.creator_id < shortlists.creator_id

// System Sessions, Security & Audit
users.user_id < sessions.user_id
users.user_id < password_reset_tokens.user_id
users.user_id < audit_log.changed_by

