# ============================================================
# GoaCreatorDB — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git!
# ============================================================

# ------ Supabase Keys (get from: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------ Database Connection (Settings → Database → URI) ----
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ------ Auth Secret (generate: openssl rand -base64 32) ----
AUTH_SECRET=replace-with-a-random-32-character-secret-string
